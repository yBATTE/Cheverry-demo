# Demo sin base de datos. false para usar el flujo real con MongoDB.
DEMO_MODE=true
DEMO_STUDENT_EMAIL=alumno@cheverry.demo
DEMO_STUDENT_PASSWORD=CheverryDemo2026!
DEMO_STUDENT_NAME=Alumno demo

# Copiar como .env. No subir este archivo con credenciales a Git.
# MongoDB Atlas o replica set: las aprobaciones usan transacciones.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/
MONGODB_DB=cheverry_academia
# Sin barra final. En Vercel cambiar por el dominio definitivo.
APP_URL=http://localhost:5178
RESEND_API_KEY=
EMAIL_FROM=Academia Cheverry <cursos@tu-dominio.com>
# Configurar antes de ejecutar npm run setup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PAYMENT_ALIAS=
PAYMENT_HOLDER=
PAYMENT_BANK=
# Dejar vacío mantiene el curso sin venta habilitada.
COURSE_PAPELERIA_PRICE=

# Opcional: URL HTTPS de un video MP4 de presentación público.
VITE_PRESENTATION_VIDEO_URL=
